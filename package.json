{
  "name": "hbc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix .",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:e2e",
    "test:e2e": "node --test \"test/e2e/*.test.js\"",
    "test:setup": "playwright install chromium",
    "test:unit": "node --test \"src/**/__tests__/*.test.js\"",
    "verify": "npm run lint && npm run format:check && npm run build && npm test"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "vite": "8.3.8"
  }
}
