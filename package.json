{
  "name": "hbc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "agent:lint:ci": "actionlint",
    "agent:lint:fix": "eslint --fix . && prettier --write . && node scripts/lint-tailwind.ts --fix",
    "agent:lint:tailwind": "node scripts/lint-tailwind.ts",
    "agent:lint:tailwind:fix": "node scripts/lint-tailwind.ts --fix",
    "agent:test:e2e": "vitest run --project e2e --reporter=tap-flat --no-color",
    "agent:test:unit": "vitest run --project unit --reporter=tap-flat --no-color",
    "agent:verify:gate": "npm run agent:verify:unit && npm run build && npm run agent:test:e2e",
    "agent:verify:inner": "npm run typecheck && npm run lint && npm run agent:lint:tailwind",
    "agent:verify:unit": "npm run agent:verify:inner && npm run agent:test:unit",
    "build": "vite build",
    "check:deadcode": "knip",
    "check:fast": "npm run typecheck && npm run lint && npm run agent:test:unit",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "lint:ci": "actionlint",
    "lint:fix": "eslint --fix .",
    "lint:tailwind": "node scripts/lint-tailwind.ts",
    "lint:tailwind:fix": "node scripts/lint-tailwind.ts --fix",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "vitest run --project e2e",
    "test:setup": "playwright install chromium",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc -b --pretty false",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run agent:lint:tailwind && npm run check:deadcode && vitest run && vite build"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/language-server": "0.16.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser-playwright": "5.1.1",
    "@vitest/eslint-plugin": "1.6.28",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "knip": "6.46.1",
    "oxc-transform-react": "0.156.0",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "prettier-plugin-packagejson": "3.1.0",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vscode-languageserver-protocol": "3.18.5"
  },
  "engines": {
    "node": "26.13.1"
  },
  "knip": {
    "ignoreBinaries": [
      "actionlint"
    ],
    "ignoreDependencies": [
      "@tailwindcss/language-server"
    ],
    "playwright": true
  }
}
